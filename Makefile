









get_authorization_code:
	curl -X GET "http://localhost:8080/realms/auth_demo/protocol/openid-connect/auth?response_type=code&client_id=public-client&scope=openid profile email public-client-audience-scope&redirect_uri=https://localhost:5001&code_challenge=D4m4J7xWR7tjMRz74RatKuORK5DYLUxl5KpFkDurgG8&code_challenge_method=S256&state=6HOsFajS3itPBsyJ"

get_access_token:
	curl -X POST "http://localhost:8080/realms/auth_demo/protocol/openid-connect/token" -H "Content-Type: application/x-www-form-urlencoded" \
		-d "grant_type=authorization_code" \
		-d "client_id=public-client" \
		-d "code=431fb52a-e4c1-3942-602b-ee07d2fe3afe.hhqw8_lmJpFr1q1fr7biPx4L.5b99a4c9-ae90-489b-bb2e-c2bb21dcb389" \
		-d "code_verifier=KupTYA86yxt1zDmev2vrjCRCHEl2wl8pB5nHG1LkpsfG4S9K6HOsFajS3itPBsyJ" \
		-d "redirect_uri=https://localhost:5001" 

